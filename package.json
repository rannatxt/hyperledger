{
  "name": "instaledger",
  "version": "1.0.0",
  "private": true,
  "description": "InstaLedger: Decentralized Instagram on Hyperledger Fabric with IPFS mock storage",
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "start": "node backend/server.js",
    "dev:backend": "cd backend && npm start",
    "dev:frontend": "cd frontend && npm run dev",
    "test": "node --test chaincode/test/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  }
}
