{
  "name": "instaledger",
  "version": "1.0.0",
  "private": true,
  "description": "InstaLedger: Tamper-proof Decentralized Instagram on Hyperledger Fabric",
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "start": "node backend/server.js",
    "dev:backend": "cd backend && npm start",
    "dev:frontend": "cd frontend && npm run dev",
    "test": "node --test chaincode/test/*.test.js",
    "test:duplicate": "node test/duplicate-check.test.js"
  },
  "dependencies": {
    "blockhash-core": "^0.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "imghash": "^1.1.4",
    "jpeg-js": "^0.4.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pngjs": "^7.0.0"
  }
}
